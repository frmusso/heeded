{
  "name": "heeded",
  "version": "0.2.0",
  "description": "did your coding agent follow its instructions?",
  "license": "MIT",
  "author": "Francesco Musso",
  "repository": { "type": "git", "url": "git+https://github.com/frmusso/heeded.git" },
  "bugs": "https://github.com/frmusso/heeded/issues",
  "homepage": "https://github.com/frmusso/heeded#readme",
  "keywords": ["claude-code", "claude", "coding-agent", "claude-md", "instructions", "transcripts", "cli"],
  "type": "module",
  "bin": { "heeded": "dist/cli.js" },
  "files": ["dist"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc",
    "test": "node --test --test-concurrency=1 'tests/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
